# ---- Core ----
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:prompthub@localhost:5432/prompthub
REDIS_URL=redis://localhost:6379

# ---- Image providers (server-side only, never expose to the browser) ----
# Used for gpt-image-2.5-flare (drafts) and gpt-image-2.5-sunburst (edits/regenerations)
OPENAI_API_KEY=sk-...
FLUX_API_KEY=
IDEOGRAM_API_KEY=

# ---- Supabase (fill in when you have your project) ----
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the API verifies
# Supabase JWTs and uploads images to Supabase Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=generated-images

# ---- Local-dev fallbacks ----
# true = skip JWT verification and auto sign-in as a dev user. Set false in prod.
DEV_AUTH_BYPASS=true
# Used when Supabase Storage isn't configured yet; files served from /uploads/*
UPLOAD_DIR=./uploads

# Run the generation worker inside the API process (fine for dev / small deploys)
WORKER_INLINE=true
