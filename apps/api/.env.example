# ---- Core ----
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# In production point this at Supabase's pooler (transaction mode, port 6543)
# with ?connection_limit= sized to your api+worker replica count — not the
# direct connection, or replicas will exhaust Postgres connections.
DATABASE_URL=postgresql://postgres:catgpt@localhost:5432/catgpt
REDIS_URL=redis://localhost:6379

# ---- Image providers (server-side only, never expose to the browser) ----
# Used for gpt-image-2.5-flare (drafts) and gpt-image-2.5-sunburst (edits/regenerations)
OPENAI_API_KEY=sk-...
FLUX_API_KEY=
IDEOGRAM_API_KEY=

# ---- Chat + PDF RAG + code execution ----
# Model for text replies; embeddings reuse OPENAI_API_KEY for PDF chunks.
CHAT_MODEL=gpt-4o-mini
# code_interpreter runs need a capable model — gpt-4o-mini doesn't support it.
CODE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
MAX_PDF_PAGES=200
MAX_UPLOAD_MB=25
RAG_TOP_K=6
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150

# ---- Jev (TypeSafe AI) — optional fast intent/routing evaluations ----
# System One model: answers typed questions (choice/score/boolean) about a
# state instead of generating text. Used for image-vs-chat classification and
# gating memory extraction. Unset = falls back to the OpenAI classifier path.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# ---- Supabase (fill in when you have your project) ----
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the API verifies
# Supabase JWTs and uploads images to Supabase Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret (Supabase dashboard -> Settings -> API) — lets the API
# verify tokens in-process instead of one getUser() network call per request.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=generated-images

# ---- Brand voice (cloned voice per brand, self-hosted) ----
# Private bucket for consented voice samples — created with public:false.
PRIVATE_STORAGE_BUCKET=brand-voice-samples
# Local fallback for private objects. MUST stay outside UPLOAD_DIR — the whole
# UPLOAD_DIR tree is served at /uploads/*.
PRIVATE_UPLOAD_DIR=./private-uploads
# Internal-only Chatterbox voice service (see infra/voice-service/). Never
# expose this URL publicly; it is sent to no one but the Node API.
# VOICE_MODEL_URL=http://127.0.0.1:8765
# Shared-secret header between the API and the voice service (optional locally).
# VOICE_SERVICE_TOKEN=

# ---- Limits ----
# Image generations per user per UTC day (chat is unlimited).
IMAGE_DAILY_LIMIT=50
# Used when Supabase Storage isn't configured yet; files served from /uploads/*
UPLOAD_DIR=./uploads

# Run the generation worker inside the API process. Defaults to true only when
# REDIS_URL is unset — with Redis configured, run a separate worker process
# (pnpm --filter @catgpt/api worker) and leave this unset/false in production.
WORKER_INLINE=true

# ---- Email (weekly report, newsletters) ----
# Resend API key. Without EMAIL_FROM the shared sandbox sender (onboarding@resend.dev) is used,
# which only delivers to the Resend account owner. Set EMAIL_FROM (e.g. "Brand <hello@yourdomain.com>")
# after verifying a domain you control in Resend (vercel.app subdomains cannot be verified).
RESEND_API_KEY=
EMAIL_FROM=

# ---- Social publishing (all optional; a connector is offered only when its credentials are set) ----
# 32-byte AES key as 64 hex chars: openssl rand -hex 32. Required by every connector.
SOCIAL_TOKEN_KEY=
# OAuth redirect URIs to register: {API_PUBLIC_URL}/social/callback/meta | /x | /google
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube uploads stay "private" until the Google OAuth app is verified; then set "public".
YOUTUBE_VISIBILITY=private
