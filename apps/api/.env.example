# ---- Core ----
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# In production point this at Supabase's pooler (transaction mode, port 6543)
# with ?connection_limit= sized to your api+worker replica count — not the
# direct connection, or replicas will exhaust Postgres connections.
DATABASE_URL=postgresql://postgres:catgpt@localhost:5432/catgpt
REDIS_URL=redis://localhost:6379

# ---- Image providers (server-side only, never expose to the browser) ----
# Used for gpt-image-2.5-flare (drafts) and gpt-image-2.5-sunburst (edits/regenerations)
OPENAI_API_KEY=sk-...
FLUX_API_KEY=
IDEOGRAM_API_KEY=

# ---- Chat + PDF RAG + code execution ----
# Model for text replies; embeddings reuse OPENAI_API_KEY for PDF chunks.
CHAT_MODEL=gpt-4o-mini
# code_interpreter runs need a capable model — gpt-4o-mini doesn't support it.
CODE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
MAX_PDF_PAGES=200
MAX_UPLOAD_MB=25
RAG_TOP_K=6
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150

# ---- Supabase (fill in when you have your project) ----
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the API verifies
# Supabase JWTs and uploads images to Supabase Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret (Supabase dashboard -> Settings -> API) — lets the API
# verify tokens in-process instead of one getUser() network call per request.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=generated-images

# ---- Limits ----
# Image generations per user per UTC day (chat is unlimited).
IMAGE_DAILY_LIMIT=50
# Used when Supabase Storage isn't configured yet; files served from /uploads/*
UPLOAD_DIR=./uploads

# Run the generation worker inside the API process. Defaults to true only when
# REDIS_URL is unset — with Redis configured, run a separate worker process
# (pnpm --filter @catgpt/api worker) and leave this unset/false in production.
WORKER_INLINE=true
