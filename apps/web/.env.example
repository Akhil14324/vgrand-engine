NEXT_PUBLIC_API_URL=http://localhost:4000

# Leave empty to run in dev mode (no login, auto dev user).
# Fill in once you have your Supabase project to enable email + Google auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mirrors the API's MAX_UPLOAD_MB — the client pre-checks file size and shows
# the limit in error messages. Keep equal to the API value.
NEXT_PUBLIC_MAX_UPLOAD_MB=25
