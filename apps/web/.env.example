NEXT_PUBLIC_API_URL=http://localhost:4000

# Required — email + password login runs on Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional demo login (testing only). When both are set, the login page shows
# this pair and a "Use demo account" button. Create the same user in Supabase
# Auth first (Authentication -> Users -> Add user, auto-confirm). Never use a
# real person's password here — NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Mirrors the API's MAX_UPLOAD_MB — the client pre-checks file size and shows
# the limit in error messages. Keep equal to the API value.
NEXT_PUBLIC_MAX_UPLOAD_MB=25
