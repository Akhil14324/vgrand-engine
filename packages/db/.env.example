# Used by prisma migrate/seed (this folder is the cwd for those commands).
# Local dev default matches docker-compose.yml; swap for your Supabase pooler URL later.
DATABASE_URL=postgresql://postgres:catgpt@localhost:5432/catgpt
# schema.prisma declares `directUrl = env("DIRECT_URL")` — prisma migrate commands
# fail with "Environment variable not found" if this is unset. For a non-pooled
# Postgres (e.g. Railway) set it to the same value as DATABASE_URL; for Supabase
# use the direct (non-pooler) connection string.
DIRECT_URL=postgresql://postgres:catgpt@localhost:5432/catgpt
