generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  generations   Generation[]
  boards        Board[]
  memories      Memory[]
  conversations Conversation[]
}

// A "chat" — groups generations into a conversation you can revisit and
// continue, like Claude/ChatGPT history.
model Conversation {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String       // auto-derived from the first prompt
  pinned      Boolean      @default(false)
  archived    Boolean      @default(false)
  generations Generation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model Theme {
  id             String       @id @default(uuid())
  slug           String       @unique // "restaurant", "infra"
  label          String // "Restaurant Posters"
  description    String?
  promptTemplate String       @db.Text // system prompt injected per theme
  styleGuide     Json? // color palette, layout hints, negative prompts, preferredProvider
  icon           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  generations    Generation[]
}

model Generation {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId      String?
  theme        Theme?      @relation(fields: [themeId], references: [id])
  kind         String      @default("image") // "image" | "text" — text = chat reply, no image
  prompt       String      @db.Text // raw user idea
  finalPrompt  String      @db.Text // template + user idea, what was actually sent
  textResponse String?     @db.Text // assistant reply for kind="text"
  provider     String // "openai" | "flux" | "ideogram"
  model        String? // "gpt-image-2.5-flare" etc.
  imageUrls    String[] // storage URLs (1+ per generation)
  status       String      @default("pending") // pending | processing | completed | failed
  error        String?
  metadata     Json? // size, quality, seed, cost, latency
  parentId       String? // for "regenerate/edit" chains
  parent         Generation? @relation("GenerationChain", fields: [parentId], references: [id], onDelete: SetNull)
  children       Generation[] @relation("GenerationChain")
  conversationId String? // chat this generation belongs to
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  boardItems     BoardItem[]
  shareLinks     ShareLink[]
  memories       Memory[]
  createdAt      DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([themeId])
  @@index([conversationId, createdAt(sort: Desc)])
}

model Board {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     BoardItem[]
  createdAt DateTime    @default(now())
}

model BoardItem {
  id           String     @id @default(uuid())
  boardId      String
  board        Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([boardId, generationId])
  @@index([boardId])
}

model Memory {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // "preference" | "fact" | "style"
  content     String      @db.Text // e.g. "prefers warm color palettes for restaurant posters"
  sourceGenId String? // generation that produced this memory
  sourceGen   Generation? @relation(fields: [sourceGenId], references: [id], onDelete: SetNull)
  // Full snapshot of what was generated — more than just the image:
  // prompt, finalPrompt, theme, provider/model, quality/size, urls, latency.
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model ShareLink {
  id           String     @id @default(uuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  token        String     @unique
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
}
