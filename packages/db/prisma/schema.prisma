generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String?
  avatarUrl         String?
  createdAt         DateTime          @default(now())
  /// ChatGPT-style switch: when off, nothing is learned and nothing is injected.
  memoryEnabled     Boolean           @default(true)
  generations       Generation[]
  memories          Memory[]
  conversations     Conversation[]
  documents         Document[]
  workspaces        Workspace[]
  imageUsage        ImageUsage[]
  brands            Brand[]
  memberships       WorkspaceMember[]
  teamMessages      TeamMessage[]
  socialAccounts    SocialAccount[]
  socialPosts       SocialPost[]
  voiceAttestations BrandVoice[]
  campaignPlans     CampaignPlan[]
}

// A brand profile: guided questionnaire answers + a compact digest that is
// injected into prompts, plus uploaded assets and documents. A user can own
// multiple personal brands; a workspace can hold many separately managed brands.
model Brand {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  profile     Json         @default("{}")
  summary     String       @default("") @db.Text // compact digest used in prompts
  assets      BrandAsset[]
  mascot      BrandMascot?
  voice       BrandVoice?
  documents   Document[]
  campaignPlans CampaignPlan[]
  generations Generation[]
  guavaProfile   GuavaProfile?
  guavaDiagnoses GuavaDiagnosis[]
  guidelines  BrandGuidelines?
  strategies  Strategy[]
  complianceChecks ComplianceCheck[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model BrandAsset {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind      String // logo | product | mascot | reference
  url       String
  label     String?
  mascot    BrandMascot?
  createdAt DateTime @default(now())

  @@index([brandId])
}

// One privately saved voice per brand: the consented reference recording that
// conditions the selected TTS model. `storageKey` is an opaque server-side
// object key — never a public or signed URL, and it is never serialized into
// DTOs. Deleting the Brand removes this row only; the stored audio object is
// cleaned up separately by the API.
model BrandVoice {
  id              String    @id @default(uuid())
  brandId         String    @unique
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  storageKey      String // private object key for the reference audio
  // Language the sample was recorded in — the code reported by the selected
  // model adapter (e.g. "te"), not a hard-coded app-level list.
  sampleLanguage  String
  scriptText      String    @db.Text // exact transcript the speaker read
  consentType     String // own_voice | authorized_voice
  consentedAt     DateTime
  attestedById    String?
  attestedBy      User?     @relation(fields: [attestedById], references: [id], onDelete: SetNull)
  status          String    @default("enrolling") // enrolling | ready | failed
  enrolledAt      DateTime? // set when the sample finished enrolling
  // Sanitized diagnostic for Brand settings only — a transient synthesis
  // failure is recorded here and must not flip a still-valid sample to failed.
  lastSynthesisError   String?   @db.Text
  lastSynthesisErrorAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([attestedById])
}

// Permanent per-image ledger behind the daily quota. No relation to
// Generation on purpose: deleting a chat must not refund quota.
model ImageUsage {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([generationId])
}

// A named collection of documents + chats — "analyze everything here" context
// that persists across conversations (replaces the old Library/boards).
model Workspace {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  documents      Document[]
  conversations  Conversation[]
  brands         Brand[]
  members        WorkspaceMember[]
  invites        WorkspaceInvite[]
  teamMessages   TeamMessage[]
  socialAccounts SocialAccount[]
  // Generated images older than this many days are deleted automatically (null = keep).
  retentionDays  Int?
  consentRecords ConsentRecord[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

// Audit trail of consent (e.g. to repost someone's content). Records are
// revoked, never edited or deleted, so the history stays trustworthy.
// kind: ugc_repost | testimonial | dm_contact | other
model ConsentRecord {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId     String?
  createdBy   String
  subject     String
  kind        String
  scope       String?   @db.Text
  evidenceUrl String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
}

// A "chat" — groups generations into a conversation you can revisit and
// continue, like Claude/ChatGPT history.
model Conversation {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String // auto-derived from the first prompt
  pinned      Boolean             @default(false)
  archived    Boolean             @default(false)
  /// Set once a turn was routed through campaign mode — avoids scanning
  /// Generation prompts on every later message to detect the mode.
  campaign    Boolean             @default(false)
  generations Generation[]
  documents   Document[]
  shares      ConversationShare[]
  campaignPlans CampaignPlan[]
  workspaceId String?
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([workspaceId])
}

model Theme {
  id             String       @id @default(uuid())
  slug           String       @unique // "restaurant", "infra"
  label          String // "Restaurant Posters"
  description    String?
  promptTemplate String       @db.Text // system prompt injected per theme
  styleGuide     Json? // color palette, layout hints, negative prompts, preferredProvider
  icon           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  generations    Generation[]
}

model Generation {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId        String?
  theme          Theme?        @relation(fields: [themeId], references: [id])
  kind           String        @default("image") // "image" | "text" — text = chat reply, no image
  prompt         String        @db.Text // raw user idea
  finalPrompt    String        @db.Text // template + user idea, what was actually sent
  textResponse   String?       @db.Text // assistant reply for kind="text"
  provider       String // "openai" | "flux" | "ideogram"
  model          String? // "gpt-image-2.5-flare" etc.
  imageUrls      String[] // storage URLs (1+ per generation)
  status         String        @default("pending") // pending | processing | completed | failed | cancelled
  error          String?
  metadata       Json? // size, quality, seed, cost, latency
  parentId       String? // for "regenerate/edit" chains
  parent         Generation?   @relation("GenerationChain", fields: [parentId], references: [id], onDelete: SetNull)
  children       Generation[]  @relation("GenerationChain")
  conversationId String? // chat this generation belongs to
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Brand this was made for (mirrors metadata.brandId so reports can query it).
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  shareLinks     ShareLink[]
  approvalLinks  ApprovalLink[]
  campaignPost   CampaignPost?
  memories       Memory[]
  socialPosts    SocialPost[]
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([themeId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([brandId, createdAt(sort: Desc)])
}

model Memory {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // "preference" | "fact" | "style"
  content     String      @db.Text // e.g. "prefers warm color palettes for restaurant posters"
  sourceGenId String? // generation that produced this memory
  sourceGen   Generation? @relation(fields: [sourceGenId], references: [id], onDelete: SetNull)
  // Full snapshot of what was generated — more than just the image:
  // prompt, finalPrompt, theme, provider/model, quality/size, urls, latency.
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// An uploaded PDF attached to a chat — text is extracted, chunked, and
// embedded into DocumentChunk rows for RAG retrieval.
model Document {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String? // linked when a generation references it
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspaceId    String? // durable home in a Workspace — survives chats
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brandId        String? // durable home in a Brand's knowledge base
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  filename       String
  storageUrl     String?
  pageCount      Int             @default(0)
  chunkCount     Int             @default(0)
  status         String          @default("processing") // processing | ready | failed
  error          String?
  summaryNotes   String? // condensed notes for long-document summaries; lazily filled, reused on repeat asks
  chunks         DocumentChunk[]
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@index([workspaceId])
  @@index([brandId])
}

// One text chunk of a Document, embedded for cosine-similarity search.
// `embedding` is pgvector — Prisma can't read it, so inserts/queries use raw SQL.
model DocumentChunk {
  id         String                       @id @default(uuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String                       @db.Text
  embedding  Unsupported("vector(1536)")?

  @@index([documentId])
}

// Public read-only link to a whole chat (text + images), revocable.
// People a workspace is shared with. The workspace owner is Workspace.userId
// and is not listed here.
model WorkspaceMember {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

// Revocable join links: whoever opens one (signed in) becomes a member.
model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token       String    @unique
  createdById String
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// The workspace's shared chat: people talk to each other, and the AI joins in
// when someone addresses it (@ai). role "ai" rows have no author.
model TeamMessage {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  role        String // user | ai
  body        String    @db.Text
  status      String    @default("done") // pending | done | failed (AI replies)
  replyToId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, updatedAt])
}

model ConversationShare {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  token          String       @unique
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model ShareLink {
  id           String     @id @default(uuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  token        String     @unique
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
}

// A connected social profile/page/channel. workspaceId null = personal scope.
// Tokens are AES-256-GCM encrypted (lib/social-crypto.ts) and never leave the
// server. status: active | expired | revoked | reauth_required. The unique key
// cannot dedupe personal accounts (NULL workspaceId is distinct in Postgres),
// so the migration adds a partial unique index for that case.
model SocialAccount {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String?
  workspace         Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          String // instagram | facebook | x | youtube
  externalAccountId String
  handle            String?
  displayName       String?
  avatarUrl         String?
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  scopes            String[]
  metadata          Json?
  status            String       @default("active")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  posts             SocialPost[]

  @@unique([workspaceId, userId, platform, externalAccountId])
  @@index([userId])
  @@index([workspaceId])
}

// Short-lived OAuth handshake. Only sha256(state) is stored; single-use.
model SocialOAuthSession {
  id              String    @id @default(uuid())
  stateHash       String    @unique
  userId          String
  workspaceId     String?
  platform        String
  codeVerifierEnc String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
}

// One row per (generation, account). `content` is the immutable snapshot the
// user approved; retries never re-derive it.
// status: pending | posting | posted | failed.
model SocialPost {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String?
  generation    Generation    @relation(fields: [generationId], references: [id], onDelete: Cascade)
  generationId  String
  account       SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String
  content       Json
  mediaUrl      String
  status        String        @default("pending")
  attemptCount  Int           @default(0)
  lastAttemptAt DateTime?
  postedAt      DateTime?
  providerState Json?
  failureCode   String?
  remoteId      String?
  remoteUrl     String?
  error         String?
  // When a status="scheduled" row should be published. The DB is the source of
  // truth; the scheduler claims due rows and hands them to the publish queue.
  scheduledFor  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([generationId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, scheduledFor])
}

// The brand's written guidelines (markdown, edited in-app). Saving re-derives
// the matching Brand.profile fields, so this document steers every generation.
model BrandGuidelines {
  id        String   @id @default(uuid())
  brandId   String   @unique
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per compliance check. Rule findings are objective; AI findings are
// opinion and kept apart. status: pass | attention | blocked.
model ComplianceCheck {
  id           String   @id @default(uuid())
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId       String
  generationId String?
  imageUrl     String?
  caption      String?  @db.Text
  status       String
  ruleFindings Json
  aiFindings   Json?
  aiSkippedReason String?
  // True when the user posted despite a failed rule (server-recorded).
  overridden   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([brandId, createdAt(sort: Desc)])
  @@index([generationId])
}

// One active mascot identity per brand. The canonical image is a normal brand
// asset, so existing asset cleanup and storage rules still apply.
model BrandMascot {
  id          String     @id @default(uuid())
  brandId     String     @unique
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assetId     String     @unique
  asset       BrandAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name        String
  description String     @db.Text
  status      String     @default("active") // active | archived
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([brandId])
}

// A client-facing review link for one generated asset. The token is the only
// credential needed to view/respond; owner routes can revoke it.
model ApprovalLink {
  id            String     @id @default(uuid())
  generationId  String
  generation    Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  token         String     @unique
  status        String     @default("pending") // pending | approved | changes_requested
  reviewerName  String?
  reviewerEmail String?
  comment       String?    @db.Text
  expiresAt     DateTime?
  revokedAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([generationId])
}

// An internal autopilot plan. Posts generate drafts on schedule; publishing is
// deliberately outside this model and always requires approval first.
model CampaignPlan {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for the per-user "Calendar drafts" plan (Papaya / chat images awaiting scheduling).
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String
  status         String        @default("active") // active | paused | completed
  timezone       String        @default("Asia/Kolkata")
  posts          CampaignPost[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([brandId])
}

model CampaignPost {
  id           String       @id @default(uuid())
  planId       String
  plan         CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  generationId String?      @unique
  generation   Generation?  @relation(fields: [generationId], references: [id], onDelete: SetNull)
  // When the finished post should be PUBLISHED (scheduledFor is when it is generated).
  publishAt    DateTime?
  scheduledFor DateTime
  platform     String?
  prompt       String       @db.Text
  caption      String?      @db.Text
  status       String       @default("scheduled") // scheduled | generating | ready_for_review | approved | failed | cancelled
  error        String?      @db.Text
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([planId, scheduledFor])
  @@index([status, scheduledFor])
}

// Explicit calendar data (never LLM-invented). The Social Calendar shows these,
// and the AI only decides which of them are relevant to a brand.
model Holiday {
  id      String   @id @default(uuid())
  date    DateTime @db.Date
  name    String
  country String   @default("IN")
  region  String?
  type    String   @default("observance") // national | festival | observance
  source  String   @default("curated")

  @@unique([date, name, country])
  @@index([date])
}

// Guava (AI business strategist). One profile per brand: the owner's answers
// about the business, kept apart from the Brand questionnaire so onboarding and
// brand creation are untouched. `values` is section -> field -> text.
model GuavaProfile {
  id        String   @id @default(uuid())
  brandId   String   @unique
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  industry  String?
  values    Json     @default("{}")
  skipped   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One diagnosis run. Rows are never overwritten: history and comparison rely on
// each keeping the profile and platform activity as they were at the time.
model GuavaDiagnosis {
  id               String         @id @default(uuid())
  brandId          String
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId           String
  status           String         @default("processing") // processing | completed | failed
  industry         String?
  completenessPct  Int            @default(0)
  profileSnapshot  Json           @default("{}")
  platformSnapshot Json?
  report           Json?
  comparison       Json?
  previousId       String? // the completed diagnosis this one is compared with
  model            String?
  error            String?        @db.Text
  messages         GuavaMessage[]
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([brandId, createdAt(sort: Desc)])
}

// Follow-up questions to a diagnosis, and Guava's answers.
model GuavaMessage {
  id          String         @id @default(uuid())
  diagnosisId String
  diagnosis   GuavaDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  role        String // user | assistant
  content     String         @db.Text
  createdAt   DateTime       @default(now())

  @@index([diagnosisId, createdAt])
}

// B Camp: a structured, editable marketing strategy for one brand. `plan` is the
// current version; every save also snapshots a StrategyVersion. Approving or
// converting never publishes or spends anything.
model Strategy {
  id           String            @id @default(uuid())
  brandId      String
  brand        Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  status       String            @default("draft") // draft | active | completed | archived
  source       String            @default("goal") // goal | guava | idea | seasonal | custom
  sourceRef    Json?
  sourceText   String?           @db.Text
  plan         Json
  version      Int               @default(1)
  startsAt     DateTime?
  approvedAt   DateTime?
  approvedById String?
  convertedAt  DateTime?
  review       Json?
  reviewedAt   DateTime?
  versions     StrategyVersion[]
  messages     StrategyMessage[]
  deliverables Deliverable[]
  tasks        ExecTask[]
  events       ExecEvent[]
  results      CampaignResult[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([brandId, status])
}

model StrategyVersion {
  id          String   @id @default(uuid())
  strategyId  String
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version     Int
  plan        Json
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([strategyId, version])
}

model StrategyMessage {
  id         String   @id @default(uuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  role       String // user | assistant
  content    String   @db.Text
  // What the assistant changed in the plan with this reply (null = discussion only).
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([strategyId, createdAt])
}

// One piece of work a campaign must produce (post, video, landing page...).
// Content lives on the linked Generation; approval and publishing state are
// read from the existing approval and SocialPost records, never duplicated.
// status: planned | drafting | awaiting_approval | changes_requested | approved | completed | cancelled
model Deliverable {
  id             String           @id @default(uuid())
  strategyId     String
  strategy       Strategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  brandId        String
  dedupeKey      String
  type           String
  title          String
  channel        String?
  format         String?
  brief          String           @default("") @db.Text
  source         Json // the plan entry this was created from
  planVersion    Int              @default(1)
  status         String           @default("planned")
  dueAt          DateTime?
  assigneeId     String?
  generationId   String?
  submittedById  String?
  submittedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?          @db.Text
  completionNote String?          @db.Text
  externalUrl    String?
  completedAt    DateTime?
  completedById  String?
  blockedReason  String?          @db.Text
  flaggedAt      DateTime?
  tasks          ExecTask[]
  results        CampaignResult[]
  events         ExecEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([strategyId, dedupeKey])
  @@index([brandId, status])
  @@index([generationId])
}

// status: todo | in_progress | blocked | done | cancelled
model ExecTask {
  id            String       @id @default(uuid())
  strategyId    String
  strategy      Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  brandId       String
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  dedupeKey     String
  title         String
  description   String       @default("") @db.Text
  checklist     Json         @default("[]")
  status        String       @default("todo")
  priority      String       @default("medium")
  assigneeId    String?
  dueAt         DateTime?
  dependsOnId   String?
  source        Json
  planVersion   Int          @default(1)
  blockedReason String?      @db.Text
  flaggedAt     DateTime?
  completedAt   DateTime?
  events        ExecEvent[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([strategyId, dedupeKey])
  @@index([brandId, status])
  @@index([assigneeId])
}

// Audit trail, comments and approval history for execution work.
model ExecEvent {
  id            String       @id @default(uuid())
  strategyId    String
  strategy      Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  taskId        String?
  task          ExecTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String?
  kind          String
  note          String?      @db.Text
  data          Json?
  createdAt     DateTime     @default(now())

  @@index([strategyId, createdAt(sort: Desc)])
  @@index([deliverableId, createdAt])
  @@index([taskId, createdAt])
}

// A measured outcome. source keeps origin honest: observed (recorded by the
// platform) | user_entered (a person verified it elsewhere) | estimate.
model CampaignResult {
  id            String       @id @default(uuid())
  strategyId    String
  strategy      Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  channel       String?
  metric        String // spend | reach | engagement | clicks | leads | inquiries | orders | revenue | other
  value         Float
  source        String
  sourceNote    String?      @db.Text
  periodStart   DateTime
  periodEnd     DateTime
  enteredById   String
  createdAt     DateTime     @default(now())

  @@index([strategyId, periodEnd(sort: Desc)])
}
